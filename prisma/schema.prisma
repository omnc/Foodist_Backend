// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  // Prisma 7 + Cloudflare Workers / D1
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
  // URL configured in prisma.config.ts for CLI; Workers use PrismaD1 adapter.
}

enum MealTypes {
  BREAKFAST
  LUNCH
  DINNER
  SIDEDISH
  APPETIZER
  DESSERT
  DRINK
  BREAD
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  username     String?
  pfpUrl       String?
  bio          String?
  recipes      Recipe[]      @relation("UserRecipes")
  comments     Comment[]
  savedRecipes SavedRecipe[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Comment {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userID], references: [id])
  userID    Int
  recipe    Recipe   @relation(fields: [recipeID], references: [id])
  recipeID  Int
  body      String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IngredientBlock {
  id      Int      @id @default(autoincrement())
  title   String
  items   IngredientBlockItem[]
  recipes Recipe[] @relation("IngredientBlockToRecipe")
}

model IngredientBlockItem {
  id Int @id @default(autoincrement())
  value String
  measurement String
  // Ingredient group (post-page "heading"); groups are ordered by groupIndex, items by position
  heading String?
  groupIndex Int @default(0)
  position Int @default(0)
  ingredientBlock IngredientBlock @relation(fields: [ingredientBlockID], references: [id])
  ingredientBlockID Int
}

model Recipe {
  id                Int                @id @default(autoincrement())
  user              User               @relation("UserRecipes", fields: [userID], references: [id])
  userID            Int
  title             String
  description       String
  mealtype          MealTypes
  servingSize       Int
  level             Int
  prepTime          Int
  cookTime          Int
  ingredientBlock   IngredientBlock    @relation("IngredientBlockToRecipe", fields: [ingredientBlockID], references: [id])
  ingredientBlockID Int
  titleImage        String?
  descriptionBlocks DescriptionBlock[]
  comments          Comment[]
  savedBy           SavedRecipe[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userID])
}

model DescriptionBlock {
  id          Int      @id @default(autoincrement())
  description String
  imageUrl    String?
  recipe      Recipe   @relation(fields: [recipeId], references: [id])
  recipeId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SavedRecipe {
  id       Int      @id @default(autoincrement())
  user     User     @relation(fields: [userID], references: [id])
  userID   Int
  recipe   Recipe   @relation(fields: [recipeID], references: [id])
  recipeID Int
  savedAt  DateTime @default(now())
  note     String?
  
  @@unique([userID, recipeID])
}
