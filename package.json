{
  "name": "Foodist_Backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "build": "prisma generate",
    "predeploy": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/adapter-d1": "6.19.0",
    "@prisma/client": "6.19.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "hono": "^4.10.6"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "prisma": "6.19.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.4.0"
  }
}
